{
  "tests": [
    {
      "name": "chat_completion_smoke_test",
      "input": {
        "messages": [
          {
            "role": "user",
            "content": "Reply with exactly: RUNPOD_OK"
          }
        ],
        "temperature": 0,
        "max_tokens": 32,
        "stream": false
      },
      "timeout": 1800000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA A40",
    "gpuCount": 1,
    "env": [
      {
        "key": "CONTEXT_SIZE",
        "value": "4096"
      },
      {
        "key": "PARALLEL",
        "value": "1"
      },
      {
        "key": "STARTUP_TIMEOUT",
        "value": "1500"
      },
      {
        "key": "MODEL",
        "value": "unsloth/Qwen3.8-27B-GGUF:UD-Q2_K_XL"
      },
      {
        "key": "MODEL_FILE",
        "value": "Qwen3.8-27B-UD-Q2_K_XL.gguf"
      }
    ]
  }
}
