{
  "tests": [
    {
      "name": "chat_completion_smoke_test",
      "input": {
        "messages": [
          {
            "role": "user",
            "content": "Reply with exactly: RUNPOD_OK"
          }
        ],
        "temperature": 0,
        "max_tokens": 32,
        "stream": false
      },
      "timeout": 1800000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA GeForce RTX 4090",
    "gpuCount": 1,
    "env": [
      {
        "key": "CONTEXT_SIZE",
        "value": "16384"
      },
      {
        "key": "PARALLEL",
        "value": "1"
      },
      {
        "key": "STARTUP_TIMEOUT",
        "value": "1800"
      }
    ]
  }
}
