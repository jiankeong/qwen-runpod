+from pathlib import Path
+import sys
+
+path = Path(sys.argv[1])
+text = path.read_text().replace('"gpuTypeId": "NVIDIA A40"', '"gpuTypeId": "NVIDIA GeForce RTX 4090"', 1)
+path.write_text(text)
+print("ROLLBACK_OK: restored RTX 4090 Hub test pool")
+PY
+  exit 0
+fi
